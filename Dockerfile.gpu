# Stage 1: builder
FROM nvidia/cuda:12.1.1-cudnn8-devel-ubuntu22.04 AS builder

WORKDIR /app

# Install Python, pip, build tools, and git
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      python3.11 python3.11-venv python3-pip build-essential git && \
    ln -sf /usr/bin/python3.11 /usr/bin/python && \
    rm -rf /var/lib/apt/lists/*

# Copy and install GPU-enabled dependencies + pytest
COPY requirements_gpu.txt .
RUN pip install --no-cache-dir -r requirements_gpu.txt \
    && pip install --no-cache-dir pytest

# Copy source code and run tests
COPY . .
RUN pytest --maxfail=1 --disable-warnings -q

# Stage 2: runtime
FROM nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04

# Create non-root user
RUN groupadd --system app && useradd --system -g app app

WORKDIR /app

# Copy installed packages and source
COPY --from=builder /usr/local/lib/python*/site-packages/ /usr/local/lib/python*/site-packages/
COPY --from=builder /app /app

USER app

CMD ["bash"]